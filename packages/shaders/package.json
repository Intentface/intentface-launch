{
  "name": "@intentface-launch/shaders",
  "version": "0.2.3",
  "license": "MIT",
  "description": "WebGPU and WebGL effects for intentface-launch: the 200+ components of the Shaders library (shaders.com) and Paper's shaders (shaders.paper.design), driven frame by frame.",
