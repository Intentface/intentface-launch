{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/out",
      "!videos/_*",
      "!videos/*/captures/*.json",
      "!videos/*/captures/*",
      "!**/*.levels.json",
      "!docs/.next",
      "!docs/.source",
      "!docs/next-env.d.ts"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  }
}
