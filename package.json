{
  "name": "intentface-launch",
  "private": true,
  "type": "module",
  "scripts": {
    "launch": "intentface-launch",
    "dev": "intentface-launch dev",
    "docs": "pnpm --filter @intentface-launch/docs dev",
    "setup": "intentface-launch setup",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "node scripts/fix.mjs",
    "check": "tsc --noEmit && (biome check . || (biome check . --reporter=summary; echo '  pnpm fix formats the changed files'; exit 1)) && intentface-launch check"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@intentface-launch/core": "workspace:*",
    "@intentface-launch/shaders": "workspace:*",
    "@intentface-launch/three": "workspace:*",
    "postprocessing": "6.39.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
